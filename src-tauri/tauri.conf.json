{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexChatPane",
  "version": "0.2.0",
  "identifier": "com.codexchatpane.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420/",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "targets": "all"
  }
}
